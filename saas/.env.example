MAT_DEMO_MODE=false
WEB_PORT=3000
# Application (client) ID of your single multi-tenant Entra app (see README section 1).
MAT_CLIENT_ID=
# Optional: override the Microsoft login library URL (default tries a vendored
# ./msal-browser.min.js first, then the Microsoft CDN). Leave empty normally.
MAT_MSAL_SRC=
# Optional: delegated scopes requested at sign-in (comma/space separated).
MAT_EXO_SCOPES=https://outlook.office365.com/.default
# Optional: Microsoft Graph delegated scopes for the Licenses + Teams + SharePoint + Entra ID + Intune categories
# (subscribedSkus + per-user assignments + teams/channels/members + sites + users + devices).
# Requires the matching API permissions + admin consent (see README section 1).
# Add AuditLog.Read.All to enable the "Last sign-in" column of the
# Unlicensed users and Entra ID Users sections (then re-consent + reconnect).
# UserAuthenticationMethod.Read.All enables the MFA column and
# RoleManagement.Read.Directory enables roles/group counts of Entra ID Users.
# Directory.Read.All resolves principal/app names in Role assignments and
# AdministrativeUnit.Read.All enables the Admin units section.
# Policy.Read.All enables External settings + Cross-tenant access,
# IdentityProvider.Read.All the External IdPs section and
# IdentityUserFlow.Read.All the sign-up user flows.
# PrivilegedEligibilitySchedule.Read.AzureADGroup +
# PrivilegedAssignmentSchedule.Read.AzureADGroup enable the PIM columns
# of the Groups section.
# AccessReview.Read.All enables the review cross-reference
# of the Admin units section.
# Application.Read.All enables the Applications sections and
# Synchronization.Read.All the provisioning lookups.
# Agreement.Read.All enables the Terms of use section.
# Device.Read.All enables the Intune Devices section.
# TeamsTelephoneNumber.Read.All enables the Teams Phone numbers section
# (Graph beta).
# EntitlementManagement.Read.All enables the Identity Governance Access
# packages section (auditor also needs Catalog reader or an Entra reader
# role on top of consent).
# CustomSecAttributeDefinition.Read.All (+ CustomSecAttributeAssignment.Read.All
# for the assignments) enables the Custom attributes section (auditor also
# needs Attribute Definition Reader or similar - Global Admin alone is not
# enough).
# Domain.Read.All enables the Domains authentication section.
# IdentityRiskyUser.Read.All enables the Risky users section.
# TermStore.Read.All enables the Term store section.
# Bookings.Read.All enables the Bookings calendars section.
# Community.Read.All enables the Viva Engage communities section.
MAT_GRAPH_SCOPES=User.Read.All Organization.Read.All Group.Read.All Team.ReadBasic.All Channel.ReadBasic.All TeamMember.Read.All ChannelMember.Read.All TeamsAppInstallation.ReadForTeam TeamsTab.Read.All Reports.Read.All ChannelMessage.Read.All Sites.Read.All SharePointTenantSettings.Read.All AuditLog.Read.All UserAuthenticationMethod.Read.All RoleManagement.Read.Directory Directory.Read.All AdministrativeUnit.Read.All Policy.Read.All IdentityProvider.Read.All IdentityUserFlow.Read.All PrivilegedEligibilitySchedule.Read.AzureADGroup PrivilegedAssignmentSchedule.Read.AzureADGroup AccessReview.Read.All Application.Read.All Synchronization.Read.All Agreement.Read.All Device.Read.All TeamsTelephoneNumber.Read.All EntitlementManagement.Read.All CustomSecAttributeDefinition.Read.All CustomSecAttributeAssignment.Read.All Domain.Read.All IdentityRiskyUser.Read.All TermStore.Read.All Bookings.Read.All Community.Read.All
# Optional: Power Platform delegated scopes for the Power Platform category
# (environments, flows, apps, custom connectors) on the unified Power
# Platform API (resource https://api.powerplatform.com, app ID
# 8578e004-a5c6-46e7-913e-12f58912df43).
# Requires those four delegated permissions + admin consent (see README
# section 1), and a Power Platform administrator role on the auditor account.
MAT_POWER_SCOPES=https://api.powerplatform.com/EnvironmentManagement.Environments.Read https://api.powerplatform.com/PowerAutomate.Flows.Read https://api.powerplatform.com/PowerApps.Apps.Read https://api.powerplatform.com/Connectivity.Connectors.Read
